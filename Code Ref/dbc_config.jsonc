{
  // ============================================================
  // 1.  基础配置
  // ============================================================
  "rpcUrl": "https://api.devnet.solana.com", // 部署前改为 mainnet
  "dryRun": true, // 测试时为 true，确认无误后改为 false
  "keypairFilePath": "./keypair.json",
  "computeUnitPriceMicroLamports": 100000,

  // ============================================================
  // 2.  Quote Mint (USDC)
  // ============================================================
  "quoteMint": "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v",

  // ============================================================
  // 3.  DBC 核心配置（包含自定义扩展字段）
  // ============================================================
  "dbcConfig": {
    // --- 3.1 曲线构建模式 ---
    "buildCurveMode": 5,
    "prices": [0.001, 0.003, 0.006, 0.01],
    "liquidityWeights": [1, 3, 6],

    // --- 3.2 代币配置 ---
    "token": {
      "totalTokenSupply": 1000000000,
      "tokenBaseDecimal": 9,
      "tokenQuoteDecimal": 6,
      "tokenType": 0,
      "tokenAuthorityOption": 1,
      "leftover": 0
    },

    // --- 3.3 费用配置 ---
    "fee": {
      "baseFeeParams": {
        "baseFeeMode": 0,
        "feeSchedulerParam": {
          "startingFeeBps": 30,
          "endingFeeBps": 30,
          "numberOfPeriod": 0,
          "totalDuration": 0
        }
      },
      "dynamicFeeEnabled": false,
      "collectFeeMode": 0,
      "creatorTradingFeePercentage": 50,
      "poolCreationFee": 0,
      "enableFirstSwapWithMinFee": false
    },

    // --- 3.4 迁移配置 ---
    "migration": {
      "migrationOption": 1,
      "migrationFeeOption": 3,
      "migrationFee": {
        "feePercentage": 1000,
        "creatorFeePercentage": 0
      },
      "migratedPoolFee": {
        "collectFeeMode": 0,
        "dynamicFee": 1,
        "poolFeeBps": 30,
        "compoundingFeeBps": 0,
        "baseFeeMode": 4,
        "marketCapFeeSchedulerParams": {
          "endingBaseFeeBps": 30,
          "numberOfPeriod": 100,
          "priceMultiple": 1000,
          "schedulerExpirationDuration": 86400
        }
      }
    },

    // --- 3.5 流动性分配 ---
    "liquidityDistribution": {
      "partnerLiquidityPercentage": 0,
      "creatorLiquidityPercentage": 0,
      "partnerPermanentLockedLiquidityPercentage": 50,
      "creatorPermanentLockedLiquidityPercentage": 50
    },

    // --- 3.6 Locked Vesting ---
    "lockedVesting": {
      "totalLockedVestingAmount": 0,
      "numberOfVestingPeriod": 0,
      "cliffUnlockAmount": 0,
      "totalVestingDuration": 0,
      "cliffDurationFromMigrationTime": 0
    },

    // --- 3.7 激活类型 ---
    "activationType": 1,

    // --- 3.8 地址配置 ---
    "leftoverReceiver": "YOUR_LEFTOVER_RECEIVER_ADDRESS",
    "feeClaimer": "YOUR_FEE_CLAIMER_ADDRESS",

    // ============================================================
    // ★★★ 自定义扩展：Alpha Vault 关联配置 ★★★
    // ============================================================
    "has_alpha_vault": true,
    "alpha_vault_config": {
      "mode": "ProRata",
      "max_buying_cap": 20000,
      "execution_price": 0.0015,
      "per_wallet_soft_cap_min": 200,
      "per_wallet_soft_cap_max": 400,
      "deposit_window_days": 4,
      "fill_window_hours": 2,
      "batches": 10,
      "batch_interval_minutes": 6,
      "start_vesting_days": 7,
      "end_vesting_days": 30,
      "escrow_fee_bps": 30,
      "cranker_address": "YOUR_CRANKER_PUBKEY",
      "whitelist_cranker": true
    }
  },

  // ============================================================
  // 4.  池子创建配置
  // ============================================================
  "dbcPool": {
    "creator": "YOUR_CREATOR_ADDRESS",
    "name": "Mongo",
    "symbol": "MONGO",
    "metadata": {
      "image": "./data/image/mongo-logo.png",
      "description": "Mongo Token on Solana - Fair Launch via Meteora DBC + Alpha Vault",
      "website": "https://mongo.io",
      "twitter": "https://x.com/mongo_project",
      "telegram": "https://t.me/mongo_project"
    }
  },

  // ============================================================
  // 5.  交易配置
  // ============================================================
  "dbcSwap": {
    "amountIn": 1.0,
    "slippageBps": 100,
    "swapBaseForQuote": false,
    "referralTokenAccount": null
  },

  // ============================================================
  // 6.  转移 Creator 权限
  // ============================================================
  "dbcTransferPoolCreator": {
    "newCreator": "YOUR_NEW_CREATOR_ADDRESS"
  }
}
